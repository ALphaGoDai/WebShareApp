<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 标签页的 WebView 都挂在这个容器里，切换时换入换出 -->
            <FrameLayout
                android:id="@+id/webViewContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="top"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/purple_500"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 底部导航栏：左边是当前标签页（首字母，太多了左右箭头翻），右边三条线按钮点开菜单 -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/white"
            android:elevation="8dp"
            android:paddingStart="4dp"
            android:paddingEnd="2dp">

            <ImageButton
                android:id="@+id/tabScrollLeft"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="向左翻标签页"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_tab_left"
                android:tint="#5F6368"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/tabScroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:descendantFocusability="afterDescendants"
                android:fillViewport="false"
                android:focusable="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tabStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ImageButton
                android:id="@+id/tabScrollRight"
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="向右翻标签页"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_tab_right"
                android:tint="#5F6368"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/menuButton"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="菜单">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_menu_hamburger"
                    android:tint="@color/purple_500" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 底栏上方的浮动提示（网页要打开别的 App 时出现）。藏起来时这个容器是零高度的，不挡页面。 -->
    <LinearLayout
        android:id="@+id/popupStack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="64dp"
        android:orientation="vertical">

        <!-- 网页请求打开别的 App（douban:// 豆瓣 之类）：浮在底栏上方的一条提示，
             和 Chrome 的「此网站请求打开 App」一样，点「打开」才真的跳走 -->
        <LinearLayout
            android:id="@+id/openAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_open_app_bar"
            android:elevation="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="4dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/openAppIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_nav_open_app"
                android:contentDescription="打开的应用" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="此网站请求打开 App"
                    android:textSize="15sp"
                    android:textColor="#202124" />

                <TextView
                    android:id="@+id/openAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textSize="13sp"
                    android:textColor="#5F6368" />
            </LinearLayout>

            <TextView
                android:id="@+id/openAppGo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="打开"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/purple_500" />

            <ImageView
                android:id="@+id/openAppClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_nav_close"
                android:tint="#5F6368"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="不再提示" />
        </LinearLayout>
    </LinearLayout>


    <!-- 标签页切换器（全屏覆盖层，Chrome 风格卡片网格） -->
    <FrameLayout
        android:id="@+id/tabSwitcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E9EBEE"
        android:elevation="16dp"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tabGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:clipToPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/white"
            android:elevation="4dp">

            <TextView
                android:id="@+id/btnNewTab"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:drawableStart="@drawable/ic_nav_add"
                android:drawablePadding="8dp"
                android:drawableTint="@color/purple_500"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="新建标签页"
                android:textSize="15sp"
                android:textColor="#202124" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 电视上给当前选中的卡片一个明确的「编辑 / 关闭」入口；
                 手机上仍用长按标题和右上角 ✕，这两个按钮只在电视模式显示。 -->
            <TextView
                android:id="@+id/switcherEdit"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:text="编辑"
                android:textSize="15sp"
                android:textColor="@color/purple_500"
                android:visibility="gone" />

            <TextView
                android:id="@+id/switcherClose"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:text="关闭"
                android:textSize="15sp"
                android:textColor="#D93025"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- 点右下角三条线弹出的菜单：竖向排列（刷新 / 已下载 / 设置）。
         下面这层透明遮罩负责"点别处收起菜单"，不挡网页的正常使用（菜单关着时是 gone）。 -->
    <View
        android:id="@+id/navMenuScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/navMenu"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="64dp"
        android:background="@drawable/bg_nav_menu"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/menuRefresh"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_refresh"
                android:tint="@color/purple_500" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="刷新"
                android:textColor="#202124"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuDownloads"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_downloads"
                android:tint="@color/purple_500" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="已下载"
                android:textColor="#202124"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_settings"
                android:tint="@color/purple_500" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="设置"
                android:textColor="#202124"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
