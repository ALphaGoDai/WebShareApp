<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 标签页的 WebView 都挂在这个容器里，切换时换入换出 -->
            <FrameLayout
                android:id="@+id/webViewContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="top"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/purple_500"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 底部导航栏：设置 / 已下载 / 标签页（带数量角标） / 刷新（长按=清缓存强刷） -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@color/white"
            android:elevation="8dp">

            <LinearLayout
                android:id="@+id/navSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_nav_settings"
                    android:tint="@color/purple_500"
                    android:contentDescription="@string/settings_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="设置"
                    android:textSize="10sp"
                    android:textColor="#5F6368" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navDownloads"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_nav_downloads"
                    android:tint="@color/purple_500"
                    android:contentDescription="@string/downloads_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="已下载"
                    android:textSize="10sp"
                    android:textColor="#5F6368" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navTabs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">

                <FrameLayout
                    android:layout_width="24dp"
                    android:layout_height="24dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_nav_tabs"
                        android:tint="@color/purple_500"
                        android:contentDescription="@string/tabs_title" />

                    <TextView
                        android:id="@+id/tabBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|top"
                        android:background="@drawable/bg_badge"
                        android:gravity="center"
                        android:minWidth="15dp"
                        android:paddingStart="3dp"
                        android:paddingEnd="3dp"
                        android:text="1"
                        android:textSize="9sp"
                        android:textColor="@color/white" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="标签页"
                    android:textSize="10sp"
                    android:textColor="#5F6368" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navRefresh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_nav_refresh"
                    android:tint="@color/purple_500"
                    android:contentDescription="刷新页面" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="刷新"
                    android:textSize="10sp"
                    android:textColor="#5F6368" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 标签页切换器（全屏覆盖层，Chrome 风格卡片网格） -->
    <FrameLayout
        android:id="@+id/tabSwitcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E9EBEE"
        android:elevation="16dp"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tabGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:clipToPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/white"
            android:elevation="4dp">

            <TextView
                android:id="@+id/btnNewTab"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:drawableStart="@drawable/ic_nav_add"
                android:drawablePadding="8dp"
                android:drawableTint="@color/purple_500"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="新建标签页"
                android:textSize="15sp"
                android:textColor="#202124" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
