<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_nav_back"
            android:tint="@color/purple_500"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/downloads_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#202124" />

        <TextView
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清空"
            android:textSize="14sp"
            android:textColor="@color/purple_500"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 两个标签：下载记录 / 缓存视频（网页里的视频长按底栏「已下载」缓存到这里） -->
    <LinearLayout
        android:id="@+id/tabRow"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/tabDownloads"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <TextView
                android:id="@+id/tabDownloadsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="下载记录"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/purple_500" />

            <View
                android:id="@+id/tabDownloadsLine"
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="@color/purple_500" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabCache"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <TextView
                android:id="@+id/tabCacheText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="缓存视频"
                android:textSize="15sp"
                android:textColor="#5F6368" />

            <View
                android:id="@+id/tabCacheLine"
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="@color/purple_500"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <!-- 批量选择模式的顶栏（长按任意一条进入）：退出 / 已选几项 / 全选 -->
    <LinearLayout
        android:id="@+id/selectionBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:background="#EDE7F6"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnSelExit"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_nav_close"
            android:tint="@color/purple_500"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="退出批量选择" />

        <TextView
            android:id="@+id/tvSelCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="已选 0 项"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#202124" />

        <TextView
            android:id="@+id/btnSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="全选"
            android:textSize="14sp"
            android:textColor="@color/purple_500"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8EAED" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 缓存视频（第二个标签的列表），和下载记录叠在同一块区域里，按标签切换显示 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cacheList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_nav_downloads"
                android:tint="#DADCE0"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="暂无下载内容"
                android:textSize="15sp"
                android:textColor="#80868B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="网页里点「存到手机」的文件会出现在这里"
                android:textSize="13sp"
                android:textColor="#9AA0A6" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cacheEmptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_nav_cache"
                android:tint="#DADCE0"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="还没有缓存视频"
                android:textSize="15sp"
                android:textColor="#80868B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="网页里放视频，长按底栏「已下载」开始缓存"
                android:textSize="13sp"
                android:textColor="#9AA0A6" />
        </LinearLayout>
    </FrameLayout>

    <!-- 批量操作条：选中若干条后出现（重试只对失败的条目生效） -->
    <LinearLayout
        android:id="@+id/batchBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#F1F3F4"
        android:visibility="gone">

        <Button
            android:id="@+id/btnBatchRetry"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="重试"
            android:textSize="15sp"
            android:textColor="@color/purple_500" />

        <Button
            android:id="@+id/btnBatchShare"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="分享"
            android:textSize="15sp"
            android:textColor="@color/purple_500" />

        <Button
            android:id="@+id/btnBatchDelete"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="删除"
            android:textSize="15sp"
            android:textColor="#D32F2F" />
    </LinearLayout>
</LinearLayout>
