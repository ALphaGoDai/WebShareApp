<?xml version="1.0" encoding="utf-8"?>
<!-- 电视标签圆片的焦点框。圆片只有 28dp，直接用 bg_tv_focus 的淡紫描边叠在紫色圆片上
     几乎看不出来（用户反馈「没有框选效果」），所以这里用「深色外圈 + 白色内圈」的双环，
     再配合聚焦时放大 1.3 倍和抬高 z 轴，遥控器走到哪一片一眼就能看到。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="2dp"
                android:color="#202124" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
