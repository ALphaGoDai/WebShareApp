<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 网页 getUserMedia 录音（轰轰爱学习的语音跟读）：WebView 侧要 onPermissionRequest 放行 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Android 11+ 的包可见性：不声明这一条，targetSdk≥30 的应用看不见任何 TTS 引擎
         （TextToSpeech 初始化拿不到引擎、voices 为空、朗读全部静默失败），
         而普通 mp3 播放不受影响——表现就是"组词/造句没声音，别的都有"。
         改动时务必保留。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>

        <!-- 网页里"打开 App"的链接（douban://…）同样受包可见性限制：这里不声明，
             resolveActivity 拿不到目标、startActivity 直接 ActivityNotFoundException，
             表现就是"点豆瓣链接没反应"。声明过的 scheme 才能认出 App 名字和图标、
             把它拉起来。要支持新站点照格式再加一条。 -->
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="douban" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="sinaweibo" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="zhihu" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="bilibili" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="youku" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="iqiyi" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="tencentvideo" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="qqlive" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="taobao" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="alipays" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="weixin" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="snssdk1128" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="xhsdiscover" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="qqmusic" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="orpheuswidget" /></intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WebShareApp"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 接收文本分享 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- 接收本机文件分享：图片 / 视频 / 音频，类型和站点 <input accept> 对齐。
                 分享进来的文件不复制、不改名，页面里一点「上传」就原样交给它。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- 相册里多选后分享走的动作 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />

        <!-- 已下载：浏览器风格的下载记录页 -->
        <activity
            android:name=".DownloadsActivity"
            android:exported="false"
            android:label="@string/downloads_title" />

        <!-- 网页资源保存到手机：走 App 自己的 DNS/TLS 通道，前台服务避免中途被杀 -->
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
